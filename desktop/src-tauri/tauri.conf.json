{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fullcourt",
  "version": "1.0.0",
  "identifier": "app.fullcourt.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fullcourt",
        "width": 1440,
        "height": 900,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "useHttpsScheme": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0c0e12"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Anthony LaRosa",
    "shortDescription": "NBA, WNBA and college basketball scores, stats and props",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
